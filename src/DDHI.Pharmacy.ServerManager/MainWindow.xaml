<Window x:Class="DDHI.Pharmacy.ServerManager.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="DDHI Smart Pharmacy - Server Control" Width="1120" Height="820" MinWidth="900" MinHeight="650" Background="#F1F6F3" FontFamily="Segoe UI" FontSize="14" Loaded="LoadedWindow">

<Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

<DockPanel><Image Source="Assets/hospital-logo.png" Width="76" Height="76" Stretch="Uniform" Margin="0,0,20,0" DockPanel.Dock="Left"/><StackPanel><TextBlock Text="DDHI Smart Pharmacy" FontSize="29" FontWeight="SemiBold"/><TextBlock Text="Server Control" FontSize="20"/><TextBlock Text="Digos Doctors Hospital, Inc. · Vicente C. Cavalida Jr. MD" Foreground="#617D6D" Margin="0,6,0,0"/></StackPanel></DockPanel>

<Border Grid.Row="1" Background="#FFF2D1" Padding="12" Margin="0,20,0,16"><TextBlock x:Name="Banner" Text="Open Connect computers and click Enable LAN. Clients find this server automatically and pair once." TextWrapping="Wrap"/></Border>

<TabControl x:Name="MainTabs" Grid.Row="2" Background="White" Padding="20">

<TabItem Header="Server status"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>

<TextBlock Text="Central server" FontSize="25" FontWeight="SemiBold" Margin="0,0,0,16"/>

<UniformGrid Columns="3" Margin="0,0,0,20"><Border Background="#EDF6F0" Padding="18" Margin="0,0,12,0"><StackPanel><TextBlock Text="PHARMACY API" FontWeight="Bold"/><TextBlock x:Name="ApiStatus" Text="Not configured" FontSize="19" Margin="0,12,0,0" TextWrapping="Wrap"/></StackPanel></Border><Border Background="#EDF6F0" Padding="18" Margin="0,0,12,0"><StackPanel><TextBlock Text="CENTRAL DATABASE" FontWeight="Bold"/><TextBlock x:Name="DatabaseStatus" Text="Not configured" FontSize="19" Margin="0,12,0,0" TextWrapping="Wrap"/></StackPanel></Border><Border Background="#EDF6F0" Padding="18"><StackPanel><TextBlock Text="HTTPS IDENTITY" FontWeight="Bold"/><TextBlock x:Name="TlsStatus" Text="Approval pending" FontSize="19" Margin="0,12,0,0" TextWrapping="Wrap"/></StackPanel></Border></UniformGrid>

<TextBlock Text="Server endpoint" FontWeight="Bold"/><TextBox x:Name="EndpointDisplay" IsReadOnly="True"/><TextBlock Text="Data location" FontWeight="Bold"/><TextBox x:Name="DataDisplay" IsReadOnly="True"/>

<WrapPanel><Button x:Name="StartButton" Content="Start server" Click="StartServer"/><Button x:Name="StopButton" Content="Stop server" Click="StopServer"/><Button Content="Check health" Click="CheckHealth"/><Button Content="Open logs folder" Click="OpenLogs"/><Button Content="Open existing server profile" Click="OpenExistingProfile"/><Button Content="Copy client address" Click="CopyClientAddress"/></WrapPanel>

<TextBlock x:Name="CertificateNote" TextWrapping="Wrap" Margin="0,16,0,12"/>

<TextBlock Text="Database accounts: ddhi_migration (schema owner) · ddhi_runtime (application). Generated credentials are protected for this Windows account." TextWrapping="Wrap" Foreground="#617D6D"/><TextBlock Text="PostgreSQL binds to 127.0.0.1. Live Cerebro posting remains disabled." Margin="0,12,0,0" TextWrapping="Wrap"/>

</StackPanel></ScrollViewer></TabItem>

<TabItem Header="Initial setup"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="Prepare a new server instance" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,12"/>

<TextBlock Text="For a new empty instance, click Set up server. Network setup is automatic. For an existing database, use Connect computers instead." TextWrapping="Wrap" Margin="0,4,0,14"/><Expander Header="Advanced setup (optional)" Margin="0,0,0,14"><StackPanel><TextBlock Text="Setup mode"/><ComboBox x:Name="ModeInput" Margin="0,4,0,12" Padding="8" SelectedIndex="0"><ComboBoxItem Content="Local evaluation"/><ComboBoxItem Content="Hospital LAN"/></ComboBox>

<TextBlock Text="Server data folder"/><TextBox x:Name="DataRootInput"/><TextBlock Text="PostgreSQL binary folder"/><TextBox x:Name="PgBinInput"/>

<UniformGrid Columns="2"><StackPanel Margin="0,0,12,0"><TextBlock Text="PostgreSQL loopback port"/><TextBox x:Name="PgPortInput"/></StackPanel><StackPanel><TextBlock Text="HTTPS API port"/><TextBox x:Name="ApiPortInput"/></StackPanel></UniformGrid>

<TextBlock Text="Internal hostname (localhost for local evaluation)"/><TextBox x:Name="HostnameInput"/><TextBlock Text="Hospital PFX path (hospital LAN mode only)"/><DockPanel><Button Content="Browse…" DockPanel.Dock="Right" Click="BrowsePfx"/><TextBox x:Name="PfxInput"/></DockPanel>

<TextBlock Text="Hospital PFX password (enter here only, never in chat)"/><PasswordBox x:Name="PfxPassword" Padding="8" Margin="0,4,0,12"/><TextBlock Text="Hospital IT approval reference (LAN mode only)"/><TextBox x:Name="ApprovalInput"/></StackPanel></Expander><CheckBox x:Name="AutoLanAfterSetup" IsChecked="True" Content="Automatically enable simple LAN after new setup" Margin="0,4,0,12"/><CheckBox x:Name="UseWindowsServices" IsChecked="True" Content="Configure PostgreSQL, API and worker as Windows services (Administrator)" Margin="0,4,0,12"/><Button x:Name="PrepareButton" Content="Set up server" HorizontalAlignment="Left" Click="PrepareServer"/>

<TextBlock Text="Creates an independent PostgreSQL cluster, ddhi_pharmacy, separate accounts, migrations and runtime grants. Local evaluation creates a localhost PFX; it does not modify Windows trust stores or approve a hospital DNS name." TextWrapping="Wrap" Margin="0,12,0,0"/></StackPanel></ScrollViewer></TabItem>

<TabItem x:Name="SimpleLanTab" Header="Connect computers"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
<TextBlock Text="Connect your pharmacy computers" FontSize="25" FontWeight="SemiBold"/>
<TextBlock Text="1. On this server: click Enable LAN.&#10;2. On each client: open the app; it finds the server automatically.&#10;3. Confirm the matching connection code once, then sign in." TextWrapping="Wrap" Margin="0,14,0,20" FontSize="17"/>
<TextBlock Text="Server network (chosen automatically; change only if needed)"/><ComboBox x:Name="NetworkAddress" Margin="0,6,0,12" Padding="10"/>
<Button x:Name="EnableLanButton" Content="Enable LAN" Click="EnableLan" HorizontalAlignment="Left"/>
<TextBlock x:Name="SimpleEndpoint" TextWrapping="Wrap" Margin="0,16,0,12" FontSize="18"/>
<TextBlock Text="Connection code - clients should show this same code"/><TextBox x:Name="PairingCodeDisplay" IsReadOnly="True" FontSize="23" FontWeight="SemiBold" Margin="0,8,0,18"/>
<TextBlock Text="The app handles HTTPS certificates and remembers the server identity. No DNS hostname, PFX import or approval ticket is needed for this simple mode. Your existing database and accounts stay in place." TextWrapping="Wrap" Margin="0,0,0,16"/>
<WrapPanel><Button x:Name="SaveConnectionButton" Content="Save connection file (fallback)" Click="SaveConnection"/><Button x:Name="SimpleRestoreButton" Content="Restore previous connection" Click="RestoreConnection"/><Button Content="Connection guide" Click="OpenConnectionGuide"/></WrapPanel>
<TextBlock Text="Automatic discovery works on the same local network. If it is blocked, copy the connection file to the client and click Open connection file. First-time pairing always requires matching the code on this screen. Use a trusted hospital LAN; no passwords or private keys are in the file." TextWrapping="Wrap" Margin="0,16,0,0"/>
</StackPanel></ScrollViewer></TabItem>
<TabItem Header="Advanced TLS"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
<TextBlock Text="Connect separate pharmacy computers" FontSize="24" FontWeight="SemiBold"/>
<TextBlock Text="Change an existing localhost or LAN connection. This keeps the database, accounts, passwords and stock in the same instance. It does not initialize or migrate a database." TextWrapping="Wrap" Margin="0,12,0,14"/>
<TextBlock x:Name="LanStateDisplay" TextWrapping="Wrap" Margin="0,0,0,14"/>
<TextBlock Text="Approved full DNS hostname (without https:// or a port)"/><TextBox x:Name="LanHostnameInput"/>
<TextBlock Text="Matching trusted server PFX"/><DockPanel><Button Content="Browse..." DockPanel.Dock="Right" Click="BrowseLanPfx"/><TextBox x:Name="LanPfxInput"/></DockPanel>
<TextBlock Text="PFX password (enter locally only)"/><PasswordBox x:Name="LanPfxPassword" Padding="8" Margin="0,4,0,12"/>
<TextBlock Text="Hospital IT approval reference"/><TextBox x:Name="LanApprovalInput"/>
<TextBlock Text="IT must map this DNS hostname to this server's LAN address and establish certificate-chain trust on the server and clients. The PFX needs its private key, a matching valid hostname and Server Authentication usage. DNS, firewall and certificate trust are not changed automatically." TextWrapping="Wrap" Margin="0,8,0,12"/>
<WrapPanel><Button x:Name="LanApplyButton" Content="Apply LAN connection and start server" Click="ApplyLanConnection"/><Button x:Name="RestoreConnectionButton" Content="Restore previous connection" Click="RestoreConnection"/></WrapPanel>
<TextBlock Text="Use approved downtime. Connection settings are backed up automatically. If the new HTTPS endpoint does not become ready, the manager attempts to restore and restart the previous connection. This configuration backup does not replace encrypted database backups." TextWrapping="Wrap" Margin="0,12,0,14"/>
<TextBlock Text="After success, test DNS and the API TCP port from each client, then browse to the Server endpoint plus /health. Use Copy client address for the base address to enter in Central API address (HTTPS), without /health. Test certificate trust on every workstation." TextWrapping="Wrap"/>
<Button Content="Open complete connection guide (PDF)" HorizontalAlignment="Left" Click="OpenConnectionGuide" Margin="0,14,0,0"/>
</StackPanel></ScrollViewer></TabItem>

<TabItem x:Name="ConnectionGuideTab" Header="Connection guide"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
<TextBlock Text="Simple automatic connection" FontSize="25" FontWeight="SemiBold"/>
<TextBlock Text="SERVER: install the server update as Administrator on the server computer. Open the existing instance, then Connect computers and Enable LAN. For a new empty instance, use Initial setup once; it enables LAN automatically." TextWrapping="Wrap" Margin="0,16,0,14" FontSize="16"/>
<TextBlock Text="CLIENTS: install the updated client on each pharmacy computer. Open it on the same network; it finds the server automatically. Check that the connection code matches the server's screen and confirm once. Then sign in with your own staff account." TextWrapping="Wrap" Margin="0,0,0,14" FontSize="16"/>
<TextBlock Text="LATER: the client remembers the server identity and reconnects automatically. Staff still sign in normally. No DNS name, manual PFX certificate or approval ticket is required in simple mode." TextWrapping="Wrap" Margin="0,0,0,14" FontSize="16"/>
<TextBlock Text="IF DISCOVERY IS BLOCKED: on the server click Save connection file, copy that small file to the client, and click Open connection file. Check the matching code once. The file has no passwords or private keys. Both computers still need a working network route; guest Wi-Fi isolation or separate VLANs can block access." TextWrapping="Wrap" Margin="0,0,0,14"/>
<TextBlock Text="EXISTING DATABASE: install over the same folder using the same Windows setup account. Keep the original data folder. Do not recreate the database or first administrator. Enabling LAN keeps users and stock and attempts rollback if setup fails." TextWrapping="Wrap" Margin="0,0,0,14"/>
<TextBlock Text="HTTPS remains encrypted and bound to the paired server key. Windows certificate trust is not changed. The server manages narrow local-subnet firewall rules for its chosen network adapter. Use a trusted hospital network; first-time code verification is required." TextWrapping="Wrap" Margin="0,0,0,14"/>
<Button Content="Open complete connection guide (PDF)" Click="OpenConnectionGuide" HorizontalAlignment="Left"/>
<TextBlock Text="Advanced TLS is optional for IT-managed deployments. Physical workstation, firewall/service/reboot and hospital acceptance still require local verification. Live Cerebro remains disabled." TextWrapping="Wrap" Margin="0,14,0,0"/>
</StackPanel></ScrollViewer></TabItem>
<TabItem Header="Accounts"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="First application administrator" FontSize="23" FontWeight="SemiBold"/><TextBlock x:Name="AdminSetupNote" Text="Check database health to determine whether an administrator already exists." TextWrapping="Wrap" Margin="0,10,0,18"/><TextBlock Text="Administrator email"/><TextBox x:Name="AdminEmail"/><TextBlock Text="Password (12+ characters, upper/lowercase, number and symbol)"/><PasswordBox x:Name="AdminPassword" Padding="10" Margin="0,4,0,14"/><Button x:Name="AdminCreateButton" Content="Create first administrator" HorizontalAlignment="Left" Click="CreateAdmin"/>

<Separator Margin="0,24"/><TextBlock Text="Certificate and hostname" FontSize="23" FontWeight="SemiBold"/><TextBox x:Name="CertificatePathDisplay" IsReadOnly="True" Margin="0,12,0,8"/><TextBox x:Name="ThumbprintDisplay" IsReadOnly="True"/><TextBlock Text="A generated localhost PFX is not a hospital-approved identity. Hospital IT must supply an approved hostname/DNS record and a certificate trusted by pharmacy workstations. Do not bypass certificate warnings." TextWrapping="Wrap" Margin="0,12,0,16"/><Button Content="Trust localhost certificate for this Windows account" HorizontalAlignment="Left" Click="TrustLocalCertificate"/><Button Content="Configure Windows services" HorizontalAlignment="Left" Click="ConfigureServices"/><Button Content="Open public local certificate" HorizontalAlignment="Left" Click="OpenCertificate"/><TextBlock Text="Opening the certificate does not install trust. Trust installation must be performed deliberately by the authorized user or hospital IT." TextWrapping="Wrap"/>

</StackPanel></ScrollViewer></TabItem>

<TabItem Header="Advanced guide"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>

<TextBlock Text="1  Install as Administrator" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="Run DDHI-SmartPharmacy-Server-Setup-x64.exe on the dedicated destination server. It installs this window, PostgreSQL binaries, API and worker. Install the Microsoft Visual C++ x64 runtime first if it is missing." TextWrapping="Wrap" Margin="0,6,0,18"/>

<TextBlock Text="2  Create the central database" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="In Initial setup, choose the data folder and localhost evaluation or hospital LAN mode. Click Set up database and HTTPS. The wizard creates ddhi_pharmacy with separate ddhi_migration and ddhi_runtime accounts and unique protected passwords. You do not need to copy SQL commands." TextWrapping="Wrap" Margin="0,6,0,18"/>

<TextBlock Text="3  Configure HTTPS and services" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="Local evaluation generates a PFX matching localhost. Use the explicit trust button only if you authorize trust for this Windows account. Hospital LAN mode requires the approved DNS hostname, approval reference and hospital-issued trusted PFX. The Windows services checkbox configures PostgreSQL, API and worker when run as Administrator." TextWrapping="Wrap" Margin="0,6,0,18"/>

<TextBlock Text="4  Create the first administrator" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="In Administrator and certificate, enter your email and a strong password, then click Create first administrator. No shared application password is shipped." TextWrapping="Wrap" Margin="0,6,0,18"/>

<TextBlock Text="5  Start and check" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="Click Start server. The status page checks HTTPS and the central database. Windows service configuration uses DDHIPostgreSQL, DDHIPharmacyApi and DDHIPharmacyWorker. Hospital IT must restrict port 8443 to approved workstations and configure DNS/certificate trust for LAN mode." TextWrapping="Wrap" Margin="0,6,0,18"/>

<TextBlock Text="6  Connect the pharmacy application" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="Use the exact Server endpoint shown on the status page. /health should report ready. In localhost evaluation, only this same server computer can connect. For multiple workstations, use the approved LAN hostname. Sign in, create individual staff and a Chief Pharmacist account. Live Cerebro remains disabled." TextWrapping="Wrap" Margin="0,6,0,18"/>

</StackPanel></ScrollViewer></TabItem><TabItem Header="Activity"><TextBox x:Name="Activity" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12"/></TabItem>

</TabControl>

<TextBlock Grid.Row="3" Text="Server Control 0.4.0 · Closing this window leaves started server processes running · Clinical data remains in the central database." Foreground="#617D6D" Margin="0,14,0,0" TextWrapping="Wrap"/>

</Grid></Window>
