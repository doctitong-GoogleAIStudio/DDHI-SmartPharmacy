<Window x:Class="DDHI.Pharmacy.ServerManager.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="DDHI Smart Pharmacy - Server Control" Width="1120" Height="820" MinWidth="900" MinHeight="650" Background="#F1F6F3" FontFamily="Segoe UI" FontSize="14" Loaded="LoadedWindow">
<Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<DockPanel><Image Source="Assets/hospital-logo.png" Width="76" Height="76" Stretch="Uniform" Margin="0,0,20,0" DockPanel.Dock="Left"/><StackPanel><TextBlock Text="DDHI Smart Pharmacy" FontSize="29" FontWeight="SemiBold"/><TextBlock Text="Server Control" FontSize="20"/><TextBlock Text="Digos Doctors Hospital, Inc. · Vicente C. Cavalida Jr. MD" Foreground="#617D6D" Margin="0,6,0,0"/></StackPanel></DockPanel>
<Border Grid.Row="1" Background="#FFF2D1" Padding="12" Margin="0,20,0,16"><TextBlock x:Name="Banner" Text="Configure an independent local server. Hospital LAN identity and certificate trust require hospital IT approval." TextWrapping="Wrap"/></Border>
<TabControl Grid.Row="2" Background="White" Padding="20">
<TabItem Header="Server status"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
<TextBlock Text="Central server" FontSize="25" FontWeight="SemiBold" Margin="0,0,0,16"/>
<UniformGrid Columns="3" Margin="0,0,0,20"><Border Background="#EDF6F0" Padding="18" Margin="0,0,12,0"><StackPanel><TextBlock Text="PHARMACY API" FontWeight="Bold"/><TextBlock x:Name="ApiStatus" Text="Not configured" FontSize="19" Margin="0,12,0,0" TextWrapping="Wrap"/></StackPanel></Border><Border Background="#EDF6F0" Padding="18" Margin="0,0,12,0"><StackPanel><TextBlock Text="CENTRAL DATABASE" FontWeight="Bold"/><TextBlock x:Name="DatabaseStatus" Text="Not configured" FontSize="19" Margin="0,12,0,0" TextWrapping="Wrap"/></StackPanel></Border><Border Background="#EDF6F0" Padding="18"><StackPanel><TextBlock Text="HTTPS IDENTITY" FontWeight="Bold"/><TextBlock x:Name="TlsStatus" Text="Approval pending" FontSize="19" Margin="0,12,0,0" TextWrapping="Wrap"/></StackPanel></Border></UniformGrid>
<TextBlock Text="Server endpoint" FontWeight="Bold"/><TextBox x:Name="EndpointDisplay" IsReadOnly="True"/><TextBlock Text="Data location" FontWeight="Bold"/><TextBox x:Name="DataDisplay" IsReadOnly="True"/>
<WrapPanel><Button x:Name="StartButton" Content="Start server" Click="StartServer"/><Button x:Name="StopButton" Content="Stop server" Click="StopServer"/><Button Content="Check health" Click="CheckHealth"/><Button Content="Open logs folder" Click="OpenLogs"/></WrapPanel>
<TextBlock x:Name="CertificateNote" TextWrapping="Wrap" Margin="0,16,0,12"/>
<TextBlock Text="Database accounts: ddhi_migration (schema owner) · ddhi_runtime (application). Generated credentials are protected for this Windows account." TextWrapping="Wrap" Foreground="#617D6D"/><TextBlock Text="PostgreSQL binds to 127.0.0.1. Live Cerebro posting remains disabled." Margin="0,12,0,0" TextWrapping="Wrap"/>
</StackPanel></ScrollViewer></TabItem>
<TabItem Header="Initial setup"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="Prepare a new server instance" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,12"/>
<TextBlock Text="Setup mode"/><ComboBox x:Name="ModeInput" Margin="0,4,0,12" Padding="8" SelectedIndex="0"><ComboBoxItem Content="Local evaluation"/><ComboBoxItem Content="Hospital LAN"/></ComboBox>
<TextBlock Text="Server data folder"/><TextBox x:Name="DataRootInput"/><TextBlock Text="PostgreSQL binary folder"/><TextBox x:Name="PgBinInput"/>
<UniformGrid Columns="2"><StackPanel Margin="0,0,12,0"><TextBlock Text="PostgreSQL loopback port"/><TextBox x:Name="PgPortInput"/></StackPanel><StackPanel><TextBlock Text="HTTPS API port"/><TextBox x:Name="ApiPortInput"/></StackPanel></UniformGrid>
<TextBlock Text="Internal hostname (localhost for local evaluation)"/><TextBox x:Name="HostnameInput"/><TextBlock Text="Hospital PFX path (hospital LAN mode only)"/><DockPanel><Button Content="Browse…" DockPanel.Dock="Right" Click="BrowsePfx"/><TextBox x:Name="PfxInput"/></DockPanel>
<TextBlock Text="Hospital PFX password (enter here only, never in chat)"/><PasswordBox x:Name="PfxPassword" Padding="8" Margin="0,4,0,12"/><TextBlock Text="Hospital IT approval reference (LAN mode only)"/><TextBox x:Name="ApprovalInput"/><CheckBox x:Name="UseWindowsServices" IsChecked="True" Content="Configure PostgreSQL, API and worker as Windows services (Administrator)" Margin="0,4,0,12"/><Button x:Name="PrepareButton" Content="Set up database and HTTPS" HorizontalAlignment="Left" Click="PrepareServer"/>
<TextBlock Text="Creates an independent PostgreSQL cluster, ddhi_pharmacy, separate accounts, migrations and runtime grants. Local evaluation creates a localhost PFX; it does not modify Windows trust stores or approve a hospital DNS name." TextWrapping="Wrap" Margin="0,12,0,0"/></StackPanel></ScrollViewer></TabItem>
<TabItem Header="Administrator and certificate"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="First application administrator" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="Available only when the application has no users. Staff and clinical roles are assigned separately." TextWrapping="Wrap" Margin="0,10,0,18"/><TextBlock Text="Administrator email"/><TextBox x:Name="AdminEmail"/><TextBlock Text="Password (12+ characters, upper/lowercase, number and symbol)"/><PasswordBox x:Name="AdminPassword" Padding="10" Margin="0,4,0,14"/><Button Content="Create first administrator" HorizontalAlignment="Left" Click="CreateAdmin"/>
<Separator Margin="0,24"/><TextBlock Text="Certificate and hostname" FontSize="23" FontWeight="SemiBold"/><TextBox x:Name="CertificatePathDisplay" IsReadOnly="True" Margin="0,12,0,8"/><TextBox x:Name="ThumbprintDisplay" IsReadOnly="True"/><TextBlock Text="A generated localhost PFX is not a hospital-approved identity. Hospital IT must supply an approved hostname/DNS record and a certificate trusted by pharmacy workstations. Do not bypass certificate warnings." TextWrapping="Wrap" Margin="0,12,0,16"/><Button Content="Trust localhost certificate for this Windows account" HorizontalAlignment="Left" Click="TrustLocalCertificate"/><Button Content="Configure Windows services" HorizontalAlignment="Left" Click="ConfigureServices"/><Button Content="Open public local certificate" HorizontalAlignment="Left" Click="OpenCertificate"/><TextBlock Text="Opening the certificate does not install trust. Trust installation must be performed deliberately by the authorized user or hospital IT." TextWrapping="Wrap"/>
</StackPanel></ScrollViewer></TabItem>
<TabItem Header="Setup guide (1–6)"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
<TextBlock Text="1  Install as Administrator" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="Run DDHI-SmartPharmacy-Server-Setup-x64.exe on the dedicated destination server. It installs this window, PostgreSQL binaries, API and worker. Install the Microsoft Visual C++ x64 runtime first if it is missing." TextWrapping="Wrap" Margin="0,6,0,18"/>
<TextBlock Text="2  Create the central database" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="In Initial setup, choose the data folder and localhost evaluation or hospital LAN mode. Click Set up database and HTTPS. The wizard creates ddhi_pharmacy with separate ddhi_migration and ddhi_runtime accounts and unique protected passwords. You do not need to copy SQL commands." TextWrapping="Wrap" Margin="0,6,0,18"/>
<TextBlock Text="3  Configure HTTPS and services" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="Local evaluation generates a PFX matching localhost. Use the explicit trust button only if you authorize trust for this Windows account. Hospital LAN mode requires the approved DNS hostname, approval reference and hospital-issued trusted PFX. The Windows services checkbox configures PostgreSQL, API and worker when run as Administrator." TextWrapping="Wrap" Margin="0,6,0,18"/>
<TextBlock Text="4  Create the first administrator" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="In Administrator and certificate, enter your email and a strong password, then click Create first administrator. No shared application password is shipped." TextWrapping="Wrap" Margin="0,6,0,18"/>
<TextBlock Text="5  Start and check" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="Click Start server. The status page checks HTTPS and the central database. Windows service configuration uses DDHIPostgreSQL, DDHIPharmacyApi and DDHIPharmacyWorker. Hospital IT must restrict port 8443 to approved workstations and configure DNS/certificate trust for LAN mode." TextWrapping="Wrap" Margin="0,6,0,18"/>
<TextBlock Text="6  Connect the pharmacy application" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="Use the exact Server endpoint shown on the status page. /health should report ready. In localhost evaluation, only this same server computer can connect. For multiple workstations, use the approved LAN hostname. Sign in, create individual staff and a Chief Pharmacist account. Live Cerebro remains disabled." TextWrapping="Wrap" Margin="0,6,0,18"/>
</StackPanel></ScrollViewer></TabItem><TabItem Header="Activity"><TextBox x:Name="Activity" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12"/></TabItem>
</TabControl>
<TextBlock Grid.Row="3" Text="Server Control 0.2.0 · Closing this window leaves started server processes running · Clinical data remains in the central database." Foreground="#617D6D" Margin="0,14,0,0" TextWrapping="Wrap"/>
</Grid></Window>
