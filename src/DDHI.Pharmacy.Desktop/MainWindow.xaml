<Window x:Class="DDHI.Pharmacy.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="DDHI Smart Pharmacy Barcode Manager" Width="1360" Height="900" MinWidth="1050" MinHeight="700" Background="#F2F6F4" FontFamily="Segoe UI" FontSize="14">
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Background="#103D31"><DockPanel Margin="18"><StackPanel DockPanel.Dock="Top"><Image Source="Assets/hospital-logo.png" Width="92" Height="92" Stretch="Uniform" Margin="0,8,0,14"/><TextBlock Text="DDHI SMART" FontWeight="Bold" FontSize="23" Foreground="White"/><TextBlock Text="PHARMACY" FontSize="23" Foreground="#8DE0B8"/><TextBlock Text="Digos Doctors Hospital, Inc." Foreground="#CCDED5" FontSize="11" Margin="0,8,0,22"/></StackPanel>
<TextBlock DockPanel.Dock="Bottom" Text="CENTRAL INVENTORY · v0.1.0&#10;Cerebro live posting disabled" Foreground="#C9DBD2" FontSize="11" Margin="0,18,0,8"/>
<ListBox x:Name="Navigation" ItemsSource="{Binding Pages}" SelectionChanged="Navigate" Background="Transparent" BorderThickness="0" Foreground="White" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="10,9"/><Setter Property="Margin" Value="0,2"/></Style></ListBox.ItemContainerStyle></ListBox></DockPanel></Border>
<Grid Grid.Column="1" Margin="30,22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<DockPanel><StackPanel><TextBlock Text="PHARMACY OPERATIONS" Foreground="#6D8377" FontSize="12" FontWeight="SemiBold"/><TextBlock Text="{Binding Title}" FontSize="30" FontWeight="SemiBold" Margin="0,5,0,4"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Refresh" Click="Refresh"/><Button Content="Sign out" Click="SignOut"/></StackPanel></DockPanel>
<Border Grid.Row="1" Background="#FFF5D6" Padding="12" Margin="0,12,0,14"><TextBlock Text="{Binding Status}" TextWrapping="Wrap"/></Border>
<WrapPanel Grid.Row="2" x:Name="Toolbar" Margin="0,0,0,10"/>
<Grid Grid.Row="3"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border x:Name="Summary" Background="White" Padding="22" Margin="0,0,0,12" Visibility="Collapsed"><StackPanel><TextBlock x:Name="SummaryText" TextWrapping="Wrap" FontSize="18"/><UniformGrid x:Name="MetricCards" Columns="3" Margin="0,18,0,0"/></StackPanel></Border>
<DataGrid x:Name="Table" Grid.Row="1" ItemsSource="{Binding Rows}" AutoGenerateColumns="True" IsReadOnly="True" CanUserAddRows="False" GridLinesVisibility="Horizontal" HeadersVisibility="Column" Background="White" BorderBrush="#DFE8E2" RowHeight="38" ColumnHeaderHeight="40" SelectionMode="Single"/>
</Grid>
<TextBlock Grid.Row="4" Text="{Binding Footer}" Foreground="#6D8377" FontSize="11" Margin="0,12,0,0"/>
</Grid>
<Border x:Name="LoginPanel" Grid.ColumnSpan="2" Background="#F2F6F4"><Grid><Border Width="470" Background="White" Padding="30" HorizontalAlignment="Center" VerticalAlignment="Center"><StackPanel><Image Source="Assets/hospital-logo.png" Width="96" Height="96" Stretch="Uniform"/><TextBlock Text="DDHI Smart Pharmacy" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,18,0,3"/><TextBlock Text="Digos Doctors Hospital, Inc.&#10;Sign in to your central pharmacy server" HorizontalAlignment="Center" Margin="0,0,0,24"/><TextBlock Text="Central API address (HTTPS)"/><TextBox x:Name="ApiAddress" AutomationProperties.Name="Central API address"/><TextBlock Text="Individual staff email"/><TextBox x:Name="Email" AutomationProperties.Name="Staff email"/><TextBlock Text="Password"/><PasswordBox x:Name="Password" Padding="10" Margin="0,4,0,16" AutomationProperties.Name="Password"/><Button Content="Connect and sign in" Click="Login"/><TextBlock x:Name="LoginStatus" TextWrapping="Wrap" Margin="0,12,0,0" Foreground="#9C3929"/><TextBlock Text="Scanner optional. No offline dispensing.&#10;Developer: Vicente C. Cavalida Jr. MD" FontSize="11" Foreground="#6D8377" Margin="0,20,0,0"/></StackPanel></Border></Grid></Border>
</Grid></Window>
